<header class="bg-white shadow-sm fixed w-full top-0 z-50">
  <div class="container mx-auto px-4">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <div class="flex items-center">
        <%= link_to root_path, class: "flex items-center" do %>
          <span class="text-2xl font-bold text-yellow-500">Yelloberry</span>
        <% end %>
      </div>

      <!-- Navigation Links -->
      <div class="hidden md:flex items-center space-x-8">
        <%= link_to "Home", "#", class: "text-yellow-500 font-medium" %>
        <%= link_to "Menu", "#", class: "text-gray-600 hover:text-yellow-500 font-medium" %>
        <%= link_to "About", "#", class: "text-gray-600 hover:text-yellow-500 font-medium" %>
        <%= link_to "Contact", "#", class: "text-gray-600 hover:text-yellow-500 font-medium" %>
      </div>

      <!-- Right Side Icons -->
      <div class="flex items-center space-x-6">
        <!-- Search -->
        <button class="p-2 hover:bg-gray-100 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>
        
        <!-- Cart -->
        <button class="p-2 hover:bg-gray-100 rounded-full relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <span class="absolute -top-1 -right-1 bg-yellow-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">2</span>
        </button>

        <!-- User Profile -->
        <button class="p-2 hover:bg-gray-100 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button class="md:hidden p-2 hover:bg-gray-100 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu (Hidden by default) -->
  <div class="md:hidden hidden">
    <div class="px-2 pt-2 pb-3 space-y-1">
      <%= link_to "Home", "#", class: "block px-3 py-2 text-yellow-500 font-medium" %>
      <%= link_to "Menu", "#", class: "block px-3 py-2 text-gray-600 hover:text-yellow-500 font-medium" %>
      <%= link_to "About", "#", class: "block px-3 py-2 text-gray-600 hover:text-yellow-500 font-medium" %>
      <%= link_to "Contact", "#", class: "block px-3 py-2 text-gray-600 hover:text-yellow-500 font-medium" %>
    </div>
  </div>
</header> 