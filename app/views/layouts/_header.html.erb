<header class="bg-white shadow-md sticky top-0 z-50">
  <div class="bg-neutral-80 text-neutral-10 py-2 text-sm text-center">
    Flat 10% off On Grocery Shop
  </div>

  <div class="container mx-auto px-4 py-4 flex items-center justify-between">
    <div class="flex items-center">
      <a href="/" class="text-xl font-bold text-primary">Berry</a>
      <span class="ml-2 text-sm text-gray-500">Vegetables</span> </div>

    <div class="flex items-center rounded-md border border-neutral-40">
      <select class="bg-transparent border-r border-neutral-40 px-3 py-2 text-sm focus:outline-none">
        <option>Categories</option>
        <option>All</option>
        <option>Fresh Vegetables</option>
        <option>Fruits</option>
        </select>
      <input type="text" placeholder="Search products ..." class="w-full px-3 py-2 text-sm focus:outline-none">
      <button class="bg-primary text-white px-3 py-2 rounded-r-md focus:outline-none">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-6a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
    </div>

    <div class="flex items-center space-x-4 text-sm">
      <a href="/login" class="flex items-center">
        <svg class="h-5 w-5 mr-1 text-neutral-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        Account
      </a>
      <a href="/wishlist" class="flex items-center">
        <svg class="h-5 w-5 mr-1 text-neutral-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 13.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        Wishlist
      </a>
      <a href="/cart" class="flex items-center">
        <svg class="h-5 w-5 mr-1 text-neutral-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z" />
        </svg>
        Cart
        <span class="ml-1 text-primary font-semibold">4 Items</span> </a>
    </div>
  </div>

  <nav class="bg-neutral-10 py-3 text-sm hidden md:block">
    <div class="container mx-auto px-4">
      <ul class="flex space-x-6">
        <li><a href="/" class="text-neutral-80 hover:text-primary">Home</a></li>
        <li><a href="/categories" class="text-neutral-80 hover:text-primary">Categories</a></li>
        <li><a href="/products" class="text-neutral-80 hover:text-primary">Products</a></li>
        <li><a href="/pages" class="text-neutral-80 hover:text-primary">Pages</a></li>
        <li><a href="/blog" class="text-neutral-80 hover:text-primary">Blog</a></li>
        <li><a href="/offers" class="text-neutral-80 hover:text-primary">Offers</a></li>
      </ul>
    </div>
  </nav>
</header>